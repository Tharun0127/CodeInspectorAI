# ---- Groq (LLM) ----
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Chat model used by every node. Check available models with:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b

# ---- GitHub ----
# Fine-grained PAT with "Pull requests: read & write" on the target repo.
# Optional for reading public repos, REQUIRED to post the review comment.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx
# Shared secret configured on the repo webhook (recommended).
# With a GitHub App, use the app's webhook secret here.
GITHUB_WEBHOOK_SECRET=

# ---- GitHub App (recommended for letting other people install it) ----
# From https://github.com/settings/apps/<your-app>. With these set, every review
# runs as the app's installation and comments come from "<slug>[bot]".
GITHUB_APP_ID=
# The URL name of the app: https://github.com/apps/<slug>
GITHUB_APP_SLUG=
# The .pem private key. Paste it with real newlines, or on one line with 

# between lines, or point GITHUB_APP_PRIVATE_KEY_PATH at the file instead.
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=/etc/secrets/github-app.pem

# ---- Behaviour ----
# Set to false to run the whole graph but skip posting to GitHub (dry run).
POST_COMMENTS=true
# Max characters of diff sent to the LLM per node.
MAX_DIFF_CHARS=15000

# ---- Web UI / dashboard ----
# Unlocks private-repo reviews on /dashboard. Leave empty to only ever show public repos.
DASHBOARD_TOKEN=
# The "try it" box on the landing page: always a dry run, public repos only.
DEMO_ENABLED=true
# Demo reviews per visitor per hour.
DEMO_RATE_LIMIT=5
# Reviews that may run at the same time.
REVIEW_CONCURRENCY=2
# Where review history (SQLite) is stored. Defaults to ./data
# DATA_DIR=
